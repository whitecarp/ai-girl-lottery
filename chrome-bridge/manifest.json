{
  "manifest_version": 3,
  "name": "AI 娘星穹抽奖台 · 本地 B 站直连桥接",
  "version": "1.1.0",
  "description": "修复 412 拦截，在本地浏览器直接转发 B 站评论接口请求（0 第三方服务器，不上传 Cookie）",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "https://b23.tv/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "bili_headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://whitecarp.github.io/ai-girl-lottery/*",
        "https://*.workers.dev/*",
        "http://127.0.0.1:*/*",
        "http://localhost:*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
